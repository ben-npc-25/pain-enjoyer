# Template only — real values go in server/.env (gitignored). Never put
# secrets in this file: it is tracked by git.

# ── PocketBase admin (superuser for the web UI at /_/) ──────────────
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASS=change-me-long-random

# ── App user (what the iOS app / test script logs in as) ────────────
APP_USER_EMAIL=runner@example.com
APP_USER_PASS=change-me-too

# ── LLM provider: "gemini" (dev, $0) | "claude" (real season) ───────
LLM_PROVIDER=gemini

# Gemini Developer API — free tier, key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude — fill these the day you flip LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DAILY=claude-haiku-4-5
CLAUDE_MODEL_WEEKLY=claude-sonnet-4-6

# ── Morning coach cron, in UTC (PocketBase cron runs UTC).
#    "0 22 * * *" = 22:00 UTC = 06:00 HKT next day. Adjust to your timezone.
#    NOTE: keep the quotes — this file is sourced by bash (spaces!).
COACH_CRON_UTC="0 22 * * *"

# ── One-way Google Sheet backup (scripts/sheet-backup.gs) ───────────
#    Deploy the Apps Script as a web app, paste its /exec URL here, and use
#    the SAME secret you set as the script's BACKUP_SECRET property. Leave
#    URL blank to disable (the button/cron then no-op).
BACKUP_SHEET_URL=
BACKUP_SHEET_SECRET=
# COACH_BACKUP_CRON_UTC="0 18 * * *"   # nightly auto-backup (optional override)
